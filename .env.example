# Google Gemini — transcription (required)
# Leída en app/api/transcribe/route.ts
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude — exercise generation (required for VE Drills)
# Leída en app/api/exercises/route.ts (modelo claude-sonnet-4-6)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Base de datos (Neon Postgres + Drizzle) — Biblioteca / Auth ---
# Runtime (pooled), leída en lib/db/index.ts
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Sin pooling, usada por drizzle-kit push (drizzle.config.ts) y el script db:push
DATABASE_URL_UNPOOLED=postgres://user:password@host-direct/db?sslmode=require

# --- Autenticación (NextAuth v5 / Auth.js) — login con Google ---
# AUTH_SECRET: requerido para firmar la sesión. Generar con: npx auth secret
AUTH_SECRET=your_auth_secret_here
# Credenciales OAuth de Google (leídas por el provider Google de Auth.js)
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# --- Envío de emails (Resend) — links de contraseña ---
# API key de Resend. Sin ella, el modo 'resend' no manda nada (pero no rompe).
RESEND_API_KEY=re_your_resend_api_key
# 'console' (imprime el mail en la terminal, NO manda) | 'resend' (manda) | 'off'.
# Si no se define: 'resend' SOLO en producción, 'console' en cualquier otro lado.
EMAIL_MODE=console
# BARRERA DE PRUEBAS: fuera de producción solo se le puede escribir a estas casillas
# (separadas por coma). Vacía = no sale ningún mail. En producción no se aplica.
EMAIL_TEST_ALLOWLIST=vos@tumail.com
# Remitente. Hasta tener dominio propio verificado en Resend, el default
# (onboarding@resend.dev) solo puede escribirle a la casilla dueña de la cuenta.
EMAIL_FROM=Virtual English <no-responder@tudominio.com>
# URL base para los links que van por mail. En Vercel se deduce sola; definirla
# solo si hace falta forzarla (p. ej. dominio propio). NUNCA sale del header Host.
APP_BASE_URL=https://tudominio.com

# --- Almacenamiento de videos (Vercel Blob) ---
# Leída por @vercel/blob en app/api/blob-upload/route.ts
BLOB_READ_WRITE_TOKEN=your_vercel_blob_rw_token
